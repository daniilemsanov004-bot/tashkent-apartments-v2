+# Инцидент 19.08.2026: один прогон завис на источнике, который начал
+# блокировать буквально каждый запрос (см. circuit breaker в
+# run.js), и т.к. concurrency-группы не было, cron-job.org каждые
+# 15 минут запускал ЕЩЁ один прогон поверх зависшего — за пару часов
+# накопилось 9 параллельных зависших прогонов одновременно, и ни один
+# не успевал дойти до отправки объявлений. cancel-in-progress: true —
+# если новый триггер приходит, пока предыдущий прогон ещё не
+# закончился, предыдущий просто отменяется вместо того, чтобы висеть
+# рядом с новым — так система сама лечится за один тик, а не копит
+# зависшие прогоны на весь запас минут GitHub Actions.
+concurrency:
+  group: scrape-apartments
+  cancel-in-progress: true
+
 jobs:
   scrape:
     runs-on: ubuntu-latest
