# --- Публичные переменные (фронтенд, начинаются с VITE_) ---
# Supabase: Project Settings → API → Project URL / anon public key.
# Это НЕ секрет — anon-ключ по дизайну можно светить в браузере,
# доступ ограничен через RLS + проверку team_members на бэкенде.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Серверные переменные (только client/api/*, задаются в Vercel →
#     Project Settings → Environment Variables, сюда для справки) ---
# service_role ключ Supabase — НЕ anon, полный доступ, обходит RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Тот же бот, что и в scraper/.env (для отправки уведомлений) — нужен
# тут для telegram-webhook.js, чтобы отвечать на кнопки/команды.
TELEGRAM_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxx

# Секрет для проверки, что запросы на /api/telegram-webhook реально
# приходят от Telegram, а не от кого попало. Придумайте случайную
# строку (напр. openssl rand -hex 24) и укажите ТУ ЖЕ строку при
# регистрации вебхука через setWebhook (см. комментарий в начале
# client/api/telegram-webhook.js).
TELEGRAM_WEBHOOK_SECRET=

# Курс $ к суму для сравнения цен при фильтрации в боте. См. пояснение
# в scraper/.env.example — актуальное значение на 04.08.2026 ~11990.
EXCHANGE_RATE_USD_UZS=11990

# --- AI-провайдеры для ИИ-поиска (client/api/_aiSearch.js, команда
#     /search в боте и поиск на сайте) — те же переменные, что и в
#     scraper/.env.example, задаются отдельно тут (Vercel), т.к. это
#     другой деплоймент-юнит. Приоритет: Gemini -> (если
#     AI_FALLBACK_ENABLED=true) Groq -> OpenRouter -> Mistral.
# Cerebras убран (19.08.2026) — их бесплатный тариф стал разовым
# $5-кредитом вместо постоянного free tier, без привязки карты не
# восстанавливается.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_FALLBACK_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
AI_TIMEOUT_MS=40000
