[Unit]
Description=Запуск tashkent-scraper каждые 15 минут

[Timer]
OnCalendar=*:0/15
# Небольшой случайный разброс (0-90с) — чтобы запуск не был секунда
# в секунду по расписанию (это тоже частью "ботовского" паттерна,
# который лучше не давать WAF на блюдечке).
RandomizedDelaySec=90
# Если сервер был выключен/перезагружался и таймер пропустил тик —
# выполнить пропущенный прогон сразу при следующей загрузке, а не
# ждать следующего 15-минутного слота.
Persistent=true
Unit=tashkent-scraper.service

[Install]
WantedBy=timers.target
