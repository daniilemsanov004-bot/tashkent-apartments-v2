# Supabase: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ВАЖНО: это service_role ключ (не anon!) — даёт полный доступ к базе,
# минуя RLS. Использовать только тут (бэкенд) и в GitHub Secrets.
# Никогда не класть его во фронтенд/client — только SUPABASE_URL там
# безопасен, ключ — нет.

# Telegram
TELEGRAM_BOT_TOKEN=123456:xxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# 3 супергруппы по типам недвижимости, с включёнными "Темами" (Topics).
# chat_id каждой — узнать так же, как TELEGRAM_CHAT_ID (через getUpdates
# после любого сообщения в группе). Бот должен быть в каждой админом
# с правом "Управление темами". Если оставить пустым — уведомления в
# эту группу просто не отправляются, ничего не сломается.
TELEGRAM_GROUP_APARTMENT=
TELEGRAM_GROUP_COMMERCIAL=
TELEGRAM_GROUP_HOUSE=
# Отдельная супергруппа "Выгодные" — объявления с below_market=true
# (цена/м² заметно ниже медианы по району/городу, см. marketStats.js)
# дублируются сюда ДОПОЛНИТЕЛЬНО к своей обычной группе/теме. Тот же
# формат chat_id, что и у групп выше; темы по районам создаются тем же
# setup-topics.js. Необязательно — если пусто, просто не используется.
TELEGRAM_GROUP_DEALS=

# ИИ-классификация (пока выключена)
USE_AI_CLASSIFICATION=false
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Курс $ к суму — используется ботом в Telegram (client/api/telegram-webhook.js
# на Vercel, НЕ этим .env) для сравнения цен в разных валютах при
# фильтрации. С 12.08.2026 нужен ТАКЖЕ скраперу (marketStats.js) —
# для объединения объявлений в $ и в сумах в одну статистику по цене
# за м² (см. groupKey в scraper/src/marketStats.js). Раньше был нужен
# только на Vercel, теперь этот же секрет нужно прописать ЕЩЁ и в
# GitHub Secrets репозитория (для scrape.yml) — без него скрапер
# просто использует запасное значение 12700 из кода, но лучше держать
# оба места в актуальном курсе. Стоит периодически сверять с курсом
# ЦБ РУз (cbu.uz) и обновлять в обоих местах.
EXCHANGE_RATE_USD_UZS=11990
